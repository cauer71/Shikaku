{
  "id": "./",
  "name": "Shikaku",
  "short_name": "Shikaku",
  "description": "Divide the grid into rectangles: each one holds exactly one number, and that number is its area. The Japanese puzzle by Nikoli, made for your phone.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "categories": [
    "games",
    "puzzle"
  ],
  "prefer_related_applications": false,
